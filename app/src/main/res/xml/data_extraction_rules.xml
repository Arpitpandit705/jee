<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules: shared prefs (including the stored batch preference
   data, which may contain the user's own PW access token) are NEVER uploaded
   to cloud backup and NEVER transferred device-to-device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
--><data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
